# Cloudflare Pages response headers for jianzipufont.com (https://developers.cloudflare.com/pages/configuration/headers/).
# No Content-Security-Policy yet: the MailerLite signup popup loads scripts, styles and frames from
# several mailerlite.com hosts; add one only after testing the download form end to end.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# A release replaces these files in place; keep caches short so people get the new font soon.
/JianZiPu.ttf
  Cache-Control: public, max-age=3600
/version.json
  Cache-Control: no-cache

# The help for AI tools (written by `npm run help:export` in app/): plain UTF-8 text, it holds Chinese
/help.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
