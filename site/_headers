# Cloudflare Pages response headers for jianzipufont.com (https://developers.cloudflare.com/pages/configuration/headers/).
# No Content-Security-Policy yet: the MailerLite signup popup loads scripts, styles and frames from
# several mailerlite.com hosts; add one only after testing the download form end to end.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# A release replaces these files in place, at the same URL, so a browser must ask each time whether
# they changed (no-cache: it keeps its copy, and an unchanged file is a short "not modified" reply).
# With max-age, a browser went on using the old font for up to that long after a release.
/JianZiPu.ttf
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache

# The help for AI tools (written by `npm run help:export` in app/): plain UTF-8 text, it holds Chinese
/help.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
