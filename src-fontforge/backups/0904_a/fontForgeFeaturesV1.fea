#   sub @area_right @area_string' by @area_string_gou3; 
#   sub @area_right' @area_string_gou3 by @area_right_gou3;
# } gou3;

# lookup gou_1 { pos [ lg_gou ] @area_string' <300 150 0 0 >;  } gou_1;
# lookup gou_2 { pos [ lg_gou ]' <170 -30 0 0 > @area_string ; } gou_2;
# lookup ti_1 {  pos [ lg_ti ] @area_string' <300 250 0 0 >;   } ti_1;
# lookup ti_2 {  pos [ lg_ti ]' <170 70 0 0 > @area_string ;  } ti_2;
# lookup pos_1 { pos [ lg_gou ]' <0 0 0 0 >  @area_string' <0 0 0 0 >;  } pos_1;
# lookup pos_2 { pos [ lg_ti ] <100 100 0 0 > @area_string <100 100 0 0 >;  } pos_2;

feature calt {
  lookup lat_to_jzp_string;
  lookup lat_to_jzp_right;
  lookup lat_to_jzp_left;
  lookup lat_to_jzp_hui;

  # pos @area_hui' <0 0 0 0> @area_hui' <0 350 0 0> @area_hui' <0 700 0 0>;
  # pos @area_hui' <0 0 0 0> @area_hui' <0 350 0 0>;

  pos @area_hui' <500 450 0 0>  @area_right_all; 
  pos @area_right_gou' <170 -220 0 0 > @area_string' <300 -80 1000 0 >; 
  pos @area_right_gou' <0 -30  1000 0 > ; 
  # pos @area_right_ti' <0 60 0 0 > @area_string' <0 60 0 0 >; 

} calt;

