languagesystem DFLT dflt;
languagesystem hani dflt;
languagesystem latn dflt;

# Base classes
@area_right_gou  = [ lg_gou]; # k
@area_right_ti = [ lg_ti ]; # ti
@area_right_all = [ lg_gou lg_ti ];
@area_string = [ md_1 md_2 md_3 md_4 md_5 md_6 md_7]; 
@area_hui = [  md_1 md_2 md_3 md_4 md_5 md_6 md_7 md_8 md_9 ];
# @area_hui = [ sm_1 sm_2 sm_3 sm_4 sm_5 sm_6 sm_7 sm_8 sm_9 ];
@area_left = [ md_ming md_zhong md_shi md_da md_gui ];

# --- Variant classes (index-aligned with bases)
@layout_gou3_area_right  = [ lg_gou ];
@layout_gou3_area_string = [ md_1 md_2 md_3 md_4 md_5 md_6 md_7 ];

@layout_ti_area_right  = [ lg_ti];
@layout_ti_area_string = [ md_1 md_2 md_3 md_4 md_5 md_6 md_7 ];

# lookup lig_test { sub d s by s; } lig_test;

# latin to chinese characters
# lookup lat_to_ch { sub [ k i one two three four five six seven ] by [ ch_k ch_i ch_1 ch_2 ch_3 ch_4 ch_5 ch_6 ch_7 ]; } lat_to_ch;
lookup lat_to_jzp_string { sub [ k u ] [ one two three four five six seven ]' by [ md_1 md_2 md_3 md_4 md_5 md_6 md_7 ]; } lat_to_jzp_string;
lookup lat_to_jzp_right { sub [ k i ] by [ lg_gou lg_ti ]; } lat_to_jzp_right;
lookup lat_to_jzp_left { sub [ s d f v x ] by [ md_ming md_zhong md_shi md_da md_gui ]; } lat_to_jzp_left;
lookup lat_to_jzp_hui { sub [ one two three four five six seven eight nine ] by [ md_1 md_2 md_3 md_4 md_5 md_6 md_7 md_8 md_9 ]; } lat_to_jzp_hui;
# lookup han_to_jzp { sub [ ch_k ch_i ch_1 ch_2 ch_3 ch_4 ch_5 ch_6 ch_7 ] by [ lg_gou lg_ti md_1 md_2 md_3 md_4 md_5 md_6 md_7 ]; } han_to_jzp;

# gou3
# lookup gou3_1 { sub @area_right_gou @area_string' by @layout_gou3_area_string; } gou3_1;
# lookup gou3_2 { sub @area_right_gou' @layout_gou3_area_string by @layout_gou3_area_right; } gou3_2;

