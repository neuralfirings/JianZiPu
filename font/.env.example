# Copy to src-fonttools/.env (gitignored): the web server reads it at start.
# Your local Builder only needs the two public values, for the Review screen's admin sign-in
# (Supabase → Project Settings → API Keys → Legacy API keys).
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon key>

# Hosted server only (Railway variables, not this file):
# SUPABASE_SERVICE_KEY=<service_role key, secret>
# JZP_FEEDBACK_URL=https://tally.so/r/<form>
