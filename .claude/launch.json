{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "builder",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "jzpbuild.webserver", "--port", "5713"],
      "cwd": "builder",
      "port": 5713
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5800", "--bind", "127.0.0.1"],
      "cwd": "site",
      "port": 5800
    },
    {
      "name": "app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "app",
      "port": 5173
    }
  ]
}
